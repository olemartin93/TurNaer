# All values are optional. Defaults point at the public, key-less APIs.
# Base path when hosted under a sub-path, e.g. /TurNaer for https://user.github.io/TurNaer/
NEXT_PUBLIC_BASE_PATH=
# Absolute site URL used for Open Graph metadata, e.g. https://user.github.io/TurNaer
NEXT_PUBLIC_SITE_URL=
# Kartverket / Geonorge services
NEXT_PUBLIC_KARTVERKET_ADDRESS_API_URL=https://ws.geonorge.no/adresser/v1
NEXT_PUBLIC_KARTVERKET_PLACENAMES_API_URL=https://api.kartverket.no/stedsnavn/v1
NEXT_PUBLIC_KARTVERKET_ELEVATION_API_URL=https://ws.geonorge.no/hoydedata/v1
# MET Norway Locationforecast
NEXT_PUBLIC_MET_API_URL=https://api.met.no/weatherapi/locationforecast/2.0
# Overpass API (OpenStreetMap). Comma-separated list; tried in order.
NEXT_PUBLIC_OVERPASS_API_URLS=https://overpass-api.de/api/interpreter
